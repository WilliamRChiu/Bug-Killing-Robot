CompileFlags:
  # -x c++: Arduino .ino sketches have no extension clang's driver recognizes,
  #   which produces zero compiler jobs and the "expected exactly one compiler
  #   job" error. Force C++ so clangd emits a single, valid compile job.
  # -std=c++20: matches CMAKE_CXX_STANDARD 20. Without it clangd falls back to
  #   an older default standard where std::string_view etc. don't exist.
  #   Must stay in sync with CMAKE_CXX_STANDARD in src/cpp/CMakeLists.txt.
  Add: [-x, c++, -std=c++20]
